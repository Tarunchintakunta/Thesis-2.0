# Environment Configuration
# Copy to .env and fill in your values (DO NOT COMMIT .env)

# Execution mode
DRY_RUN=0  # 0=live AWS (required for evidence)

# AWS Configuration (only needed if DRY_RUN=0)
AWS_PROFILE=default
AWS_REGION=us-east-1
S3_BUCKET=your-test-bucket-name
S3_PREFIX=test-data/

# Experiment Configuration
RANDOM_SEED=42
NUM_OBJECTS=1000
EXPERIMENT_DAYS=90
